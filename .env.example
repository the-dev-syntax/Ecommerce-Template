# App
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_SLOGAN=
NEXT_PUBLIC_APP_DESCRIPTION=
# Canonical public origin (e.g. https://example.com). NEXT_PUBLIC_SITE_URL
# wins; SERVER_URL/BASE_URL are accepted as legacy fallbacks.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SERVER_URL=
NEXT_PUBLIC_BASE_URL=

# Database / auth
MONGODB_URI=
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Phone verification (Tawked Verify — https://docs.tawked.com/)
# tk_test_... sends only to the account owner's phone; tk_live_... after approval.
TAWKED_SMS_API_KEY=
# Optional; defaults to https://tawked.com
TAWKED_API_BASE=

# Email
RESEND_API_KEY=
SENDER_EMAIL=
SENDER_NAME=

# Uploads
UPLOADTHING_TOKEN=
UPLOADTHING_SECRET=

# Upstash Redis (rate limits, session revocation)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: header your edge/proxy overwrites with the real client IP
# (for example x-real-ip or cf-connecting-ip). When unset, the rate limiter
# trusts x-vercel-forwarded-for / x-real-ip / cf-connecting-ip and falls back
# to the right-most X-Forwarded-For value. If none is present, production
# fails closed instead of using a shared user-agent bucket.
TRUSTED_IP_HEADER=

# Destructive seed guard: lib/db/seed.ts refuses to run on production/Vercel
# unless this is "true" or the script is invoked with --force.
SEED_ALLOW_DESTRUCTIVE=

# Upstash QStash (optional background jobs; see README Backlog)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Cron authentication for stock-reservation expiry
CRON_SECRET=

# PayPal
PAYPAL_API_URL=
PAYPAL_CLIENT_ID=
PAYPAL_APP_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Moyasar (Saudi Arabia)
MOYASAR_PUBLISHABLE_KEY=
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# ZATCA / Fatoora (never commit real values; use a secret manager)
ZATCA_ENV=
ZATCA_SANDBOX_BASE_URL=
ZATCA_SANDBOX_USERNAME=
ZATCA_SANDBOX_PASSWORD=
ZATCA_ACCEPT_VERSION=
ZATCA_SANDBOX_OTP=
# Persist the EGS private key/CSIDs and ICV/PIH state outside git.
ZATCA_EGS_STATE=
# Onboarding/verification tooling (scripts only; never expose to the app).
ZATCA_OTP=
ZATCA_EGS_STATE_FILE=
ZATCA_EGS_UUID=
ZATCA_EGS_MODEL=
ZATCA_EGS_BRANCH_NAME=
ZATCA_EGS_BRANCH_INDUSTRY=
ZATCA_EGS_LOCATION=
ZATCA_EGS_COMMON_NAME=
ZATCA_EGS_INVOICE_TYPE=0100
ZATCA_SOLUTION_NAME=
